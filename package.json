{
  "name": "bs-frontend-generator",
  "version": "1.0.0",
  "description": "Professional frontend scaffolding framework for Next.js and Vite projects",
  "type": "module",
  "bin": {
    "bs-frontend-generator": "./dist/bin/cli.js"
  },
  "main": "./dist/bin/cli.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node scripts/create-project.ts",
    "create": "node dist/bin/cli.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "inquirer": "^8.2.5",
    "chalk": "^5.3.0",
    "fs-extra": "^11.2.0",
    "commander": "^11.1.0"
  },
  "devDependencies": {
    "typescript": "^5.5.2",
    "@types/node": "^20.10.6",
    "@types/inquirer": "^8.2.5",
    "@types/fs-extra": "^11.0.4",
    "ts-node": "^10.9.1"
  },
  "engines": {
    "node": ">=18.17.0",
    "pnpm": ">=9.0.0"
  },
  "keywords": [
    "scaffold",
    "generator",
    "nextjs",
    "vite",
    "react",
    "frontend",
    "cli",
    "template",
    "zustand",
    "storybook"
  ],
  "author": "Your Organization",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/bs-frontend-generator"
  }
}
